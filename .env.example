# Copy this file to .env and provide rotated credentials.
# Never commit .env.

APP_ENV=development
PERSONA_LOCAL_IDENTITY=false
PERSONA_LOCAL_HF_USERNAME=

MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
HF_TOKEN=
SPACE_HF_SERVICE_TOKEN=
HF_CAPSULE_REPO_ID=
ELEVENLABS_API_KEY=
VOICE_TEMPORARY_HOURS=24
FLUX_LORA_REPO_ID=
HF_DEEP_REPO_PREFIX=persona-capsule

ENABLE_CREATION=true
ENABLE_STEERING=true
ENABLE_CARD=true
ENABLE_VOICE=true
ENABLE_FUSION=true
ENABLE_BATTLE=true
