# Copy to .env for local development. Never commit .env.

# Hugging Face token (optional locally; required for Hub storage and OAuth Spaces)
HF_TOKEN=

# Modal credentials (required to submit visual LoRA training jobs)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Path to image dataset inside the Modal `my-dataset` volume
MODAL_DATASET_PATH=/dataset/dataset/PicS/PicS

# Modal output volume name (must match run_modal.py)
MODAL_MODEL_VOLUME=flux-lora-models

# FLUX base model for visual LoRA training
FLUX_BASE_MODEL=black-forest-labs/FLUX.2-klein-base-4B

# Default training steps for capsule-generated configs
DEFAULT_TRAINING_STEPS=1800

# ElevenLabs Instant Voice Cloning (optional)
ELEVENLABS_API_KEY=

# Application mode: auto | local | production
# local = mock/dry-run providers, no GPU required for the Gradio app
PERSONA_CAPSULE_MODE=local

# Local dev user when OAuth is unavailable
DEV_USER_ID=dev-user
DEV_USER_NAME=Local Developer

# Storage directory for capsule records and generated training configs
PERSONA_CAPSULE_DATA_DIR=./artifacts

# Server bind address
HOST=127.0.0.1
PORT=7860
