QUOTA_CREATION_DAILY=10
QUOTA_STEERING_DAILY=20
QUOTA_CARD_DAILY=10
QUOTA_VOICE_DAILY=5
QUOTA_FUSION_DAILY=8
QUOTA_BATTLE_DAILY=6
